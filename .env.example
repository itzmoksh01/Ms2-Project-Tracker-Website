# ============================================================================
# MS2 Project Tracker — Environment Variables
# ============================================================================
# Copy this file to `.env` for local dev, or set these in
# Netlify → Site settings → Environment variables for the hosted site.
# ============================================================================

# GEMINI_API_KEY (server-side only — NEVER prefix with VITE_)
# Powers the "MS2 AI" chatbot via the Netlify Function at /api/gemini/chat.
# Get one at https://aistudio.google.com/apikey
# In AI Studio this was injected automatically from user secrets.
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: the public URL of the hosted app (used for self-referential links).
APP_URL="https://ms2-project-tracker.netlify.app"

# --- Firebase (client-side, VITE_ prefix required) ---
# Defaults in src/services/firebase.ts already point at the live MS2 project
# (geometric-binder-djhcx). Set these only to point the app at a different
# Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
